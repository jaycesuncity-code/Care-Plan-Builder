# Copy to .dev.vars for `wrangler pages dev`. .dev.vars is gitignored — this
# repo is public, so never put a real secret in a tracked file.
#
#   cp .dev.vars.example .dev.vars
#
# In production the intake values below are SECRETS (encrypted) in Cloudflare.
# The pricing-editor section at the bottom adds two required dashboard-only
# secrets plus an optional named-exception list:
# Pages project -> Settings -> Variables and Secrets. Because this repo has a
# wrangler.toml, the dashboard can only add/remove *secrets* — plaintext vars
# must live in wrangler.toml's [vars]. See SETUP.md.

# --- Turnstile -------------------------------------------------------------
# Sandbox testing secret that ALWAYS PASSES (pairs with sitekey 1x00000000000000000000AA).
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"
# Other Cloudflare sandbox secrets, handy for testing:
#   always fails:  2x0000000000000000000000000000000AA
#   token already spent: 3x0000000000000000000000000000000AA

# --- n8n -------------------------------------------------------------------
# Local mock for testing: npm run mock:n8n  (listens on 8799)
N8N_WEBHOOK_URL="http://127.0.0.1:8799/webhook/care-plan-request"
# Production is the n8n Cloud production URL:
#   https://suncityautomation.app.n8n.cloud/webhook/care-plan-request
# Test URL (only live while the n8n editor is listening):
#   https://suncityautomation.app.n8n.cloud/webhook-test/care-plan-request
N8N_WEBHOOK_SECRET="local-dev-webhook-secret"

# --- Rate limit IP hashing -------------------------------------------------
# Any long random string. Rotating it just resets the counters.
IP_HASH_SALT="local-dev-salt-change-me"

# --- Non-secret config ----------------------------------------------------
# These two live in wrangler.toml [vars] in production; they are repeated here
# only so `wrangler pages dev` behaves the same locally.
DASHBOARD_URL="http://localhost:8788"
ALLOWED_ORIGINS="http://localhost:8788,http://127.0.0.1:8788"

# Optional overrides (defaults: 5 submissions per 600 seconds per IP)
# RATE_LIMIT_MAX="5"
# RATE_LIMIT_WINDOW_SECONDS="600"

# TEST ONLY — points Turnstile siteverify at a local mock. Leave unset in
# production so the real https://challenges.cloudflare.com endpoint is used.
# TURNSTILE_VERIFY_URL="http://127.0.0.1:8799/turnstile/siteverify"


# --- Pricing editor / Cloudflare Access ------------------------------------
# Production/Preview: add ACCESS_TEAM_DOMAIN and ACCESS_AUD to the GATED
# DASHBOARD project as encrypted Secrets. ACCESS_AUD must be the AUD tag for
# the pricing-specific Access application protecting /pricing* +
# /api/pricing-admin*, NOT the dashboard application's AUD.
#
# Any verified Access email exactly on @suncitylc.com may edit pricing.
# PRICING_EDITORS is optional and only for named exceptions outside that domain.
PRICING_EDITORS="editor@example.com,another-editor@example.com"
ACCESS_TEAM_DOMAIN="your-team.cloudflareaccess.com"
ACCESS_AUD="replace-with-pricing-access-application-aud"

# LOCAL DEV ONLY — bypasses Access only when request hostname is localhost or
# 127.0.0.1. It cannot activate on a deployed hostname.
DEV_ADMIN_EMAIL="local-editor@example.com"

# TEST ONLY — lets automated tests point JWT verification at a local JWKS.
# Leave unset in production so https://<ACCESS_TEAM_DOMAIN>/cdn-cgi/access/certs is used.
# ACCESS_JWKS_URL="http://127.0.0.1:8799/access/jwks"

# --- Catalog publishing (gated dashboard only; leave blank locally) ---------
CATALOG_DEPLOY_HOOK_URLS=""
PUBLIC_CATALOG_URL=""
# BUILD environment only, on each Pages project generating catalog.json.
# Set through the Pages build environment; .dev.vars is not read by the Node build.
# CLOUDFLARE_API_TOKEN="replace-with-D1-read-only-token"
# CLOUDFLARE_ACCOUNT_ID="replace-with-account-id"
# D1_DATABASE_ID="2c79b253-9f8d-4441-b2ca-6666ac23196a"
